{
  "name": "qaqh-electron",
  "version": "2.0.0",
  "private": true,
  "description": "QAQ-Harness Linux/Cross-platform Electron Shell for qaqh-backend and qaqh-desktop-app",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build:main": "node scripts/bundle.mjs main",
    "build:preload": "node scripts/bundle.mjs preload",
    "build": "node scripts/bundle.mjs all",
    "dev": "node scripts/dev.mjs",
    "package:linux": "pnpm run build && electron-builder --linux",
    "package:appimage": "pnpm run build && electron-builder --linux AppImage",
    "package:deb": "pnpm run build && electron-builder --linux deb",
    "package:dir": "pnpm run build && electron-builder --linux dir",
    "build:all": "node scripts/build-all.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "qaqh",
    "electron",
    "agent",
    "linux",
    "ai"
  ],
  "author": "QAQ-Harness Team",
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@qaqh/sdk": "file:../qaqh-sdk"
  }
}
